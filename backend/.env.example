# 复制本文件为 .env 并填入你自己的 Key（.env 不会进仓库，已被 .gitignore 忽略）
# 豆包（火山方舟）API Key：服务端专用，前端永远看不到
DOUBAO_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容端点（火山方舟默认地址）
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# 模型名（豆包免费/小模型示例）
DOUBAO_MODEL=doubao-seed-2-1-pro-260915

# 允许跨域访问的前端域名（GitHub Pages 地址），多个用逗号分隔；* 表示允许全部
CORS_ORIGINS=https://gao603982757-mango.github.io
